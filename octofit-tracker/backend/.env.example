# Example environment variables for Octofit backend

# MongoDB connection (you can use MONGO_HOST/MONGO_PORT/MONGO_DB or MONGO_URL)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=octofit_db

# Backend port (defaults to 8000)
PORT=8000

# Alternatively provide a complete Mongo connection string
# MONGO_URL=mongodb://localhost:27017/octofit_db
