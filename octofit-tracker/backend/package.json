    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "mongoose": "^7.6.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "ts-node-dev": "^2.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.1"
  }
}
